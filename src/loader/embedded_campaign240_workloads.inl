inline std::vector<uint8_t> load_campaign240_workload(const std::string& name) {
    std::vector<std::string> search_paths = {
        "guest-sdk/examples/" + name + "/" + name + ".macho",
        "../guest-sdk/examples/" + name + "/" + name + ".macho",
        "../../guest-sdk/examples/" + name + "/" + name + ".macho",
        "D:/WinISO26/WinIOS/guest-sdk/examples/" + name + "/" + name + ".macho"
    };
    for (const auto& path : search_paths) {
        std::ifstream f(path, std::ios::binary | std::ios::ate);
        if (f.is_open()) {
            auto size = f.tellg();
            f.seekg(0, std::ios::beg);
            std::vector<uint8_t> buf(static_cast<size_t>(size));
            f.read(reinterpret_cast<char*>(buf.data()), size);
            if (!buf.empty()) return buf;
        }
    }
    if (name == "arith_control") return get_embedded_campaign240_arith_control();
    if (name == "mem_func") return get_embedded_campaign240_mem_func();
    if (name == "syscall_lifecycle") return get_embedded_campaign240_syscall_lifecycle();
    if (name == "multi_app_worker") return get_embedded_campaign240_multi_app_worker();
    return {};
}

