function(expect code expected)
    execute_process(COMMAND "${APP}" ${ARGN} RESULT_VARIABLE actual
                    OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
    if(NOT "${actual}" STREQUAL "${code}")
        message(FATAL_ERROR "Expected ${code}, got ${actual}: ${ARGN}\n${output}\n${error}")
    endif()
    string(FIND "${output}${error}" "${expected}" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "Missing '${expected}': ${ARGN}\n${output}\n${error}")
    endif()
    math(EXPR next "${checks} + 1")
    set(checks ${next} PARENT_SCOPE)
    set(last_output "${output}" PARENT_SCOPE)
endfunction()
