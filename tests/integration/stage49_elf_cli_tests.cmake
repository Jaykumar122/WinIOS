if(NOT DEFINED APP OR NOT DEFINED FIXTURES OR NOT DEFINED TEST_DIR OR NOT DEFINED SUITE)
    message(FATAL_ERROR "Missing CLI integration test configuration")
endif()
file(MAKE_DIRECTORY "${TEST_DIR}")
execute_process(COMMAND "${FIXTURES}" "${TEST_DIR}" RESULT_VARIABLE generated TIMEOUT 10)
if(NOT generated STREQUAL "0")
    message(FATAL_ERROR "ELF fixture generation failed: ${generated}")
endif()
set(checks 0)
function(expect_run expected_code expected_output)
    execute_process(COMMAND "${APP}" ${ARGN} RESULT_VARIABLE code
                    OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 10)
    if(NOT "${code}" STREQUAL "${expected_code}")
        message(FATAL_ERROR "Exit ${code}, expected ${expected_code}: ${ARGN}\n${output}\n${error}")
    endif()
    string(FIND "${output}${error}" "${expected_output}" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "Missing '${expected_output}': ${ARGN}\n${output}\n${error}")
    endif()
    math(EXPR next "${checks} + 1")
    set(checks ${next} PARENT_SCOPE)
    set(last_output "${output}" PARENT_SCOPE)
endfunction()
set(common --memory-size 0x8000 --max-instructions 20)
set(valid "${TEST_DIR}/valid with spaces.elf")

if(SUITE STREQUAL "success")
    expect_run(0 "Status: completed" --run-elf "${valid}" ${common})
    set(reference "${last_output}")
    foreach(required "Instructions executed: 4" "X0: 42" "Memory[0x100]: 42" "SP: 32768")
        string(FIND "${reference}" "${required}" found)
        if(found EQUAL -1)
            message(FATAL_ERROR "Missing execution result ${required}: ${reference}")
        endif()
    endforeach()
    expect_run(0 "Status: completed" --run-elf "${valid}" ${common})
    if(NOT last_output STREQUAL reference)
        message(FATAL_ERROR "Repeated ELF CLI execution was not deterministic")
    endif()
    expect_run(0 "PC=0x1000" --run-elf "${valid}" ${common} --trace)
    set(reference "${last_output}")
    expect_run(0 "Status: completed" --run-elf "${valid}" ${common} --trace)
    if(NOT last_output STREQUAL reference)
        message(FATAL_ERROR "Repeated ELF CLI trace was not deterministic")
    endif()
    expect_run(0 "SP: 28672" --run-elf "${TEST_DIR}/high.elf" ${common}
               --stack-base 0x6000 --stack-size 0x1000)
elseif(SUITE STREQUAL "failures")
    expect_run(2 "Status: instruction_limit_reached" --run-elf "${TEST_DIR}/loop.elf" ${common})
    expect_run(1 "Status: unsupported_instruction" --run-elf "${TEST_DIR}/unsupported.elf" ${common})
    expect_run(1 "Status: memory_fault" --run-elf "${TEST_DIR}/fault.elf" ${common})
    expect_run(1 "Status: load_error" --run-elf "${TEST_DIR}/malformed.elf" ${common})
    expect_run(1 "Status: load_error" --run-elf "${TEST_DIR}/absent.elf" ${common})
    expect_run(1 "Status: invalid_configuration" --run-elf "${valid}" ${common}
               --stack-base 0x1000 --stack-size 0x1000)
    expect_run(1 "16-byte aligned" --run-elf "${valid}" ${common} --stack-size 0xFFF --stack-base 0x6000)
    expect_run(1 "Status: invalid_configuration" --run-elf "${valid}" ${common}
               --stack-base 0xFFFFFFFFFFFFFFFF --stack-size 16)
    expect_run(2 "Status: instruction_limit_reached" --run-binary "${TEST_DIR}/raw.bin"
               --memory-size 0x8000 --entry 0 --max-instructions 2)
elseif(SUITE STREQUAL "arguments")
    expect_run(1 "Missing binary path" --run-elf)
    expect_run(1 "--run-elf requires" --run-elf "${valid}")
    expect_run(1 "--run-elf requires" --run-elf "${valid}" --memory-size 0x8000 --max-instructions 0)
    expect_run(1 "Invalid value" --run-elf "${valid}" --memory-size -1 --max-instructions 2)
    expect_run(1 "Invalid value" --run-elf "${valid}" --memory-size 18446744073709551616 --max-instructions 2)
    expect_run(1 "Invalid value" --run-elf "${valid}" --memory-size 0x --max-instructions 2)
    expect_run(1 "Unknown guest-run option" --run-elf "${valid}" ${common} --entry 0x1000)
    expect_run(1 "Unknown guest-run option" --run-elf "${valid}" ${common} --sentinel 0x2000)
    expect_run(1 "Missing stack base" --run-elf "${valid}" ${common} --stack-base)
    expect_run(1 "Missing stack size" --run-elf "${valid}" ${common} --stack-size)
    expect_run(1 "too small" --run-elf "${valid}" --memory-size 1024 --max-instructions 2)
    expect_run(1 "Status: invalid_configuration" --run-elf "${valid}" ${common} --stack-size 0)
    expect_run(1 "Unknown guest-run option" --run-binary "${TEST_DIR}/raw.bin" ${common} --entry 0 --stack-base 0x6000)
else()
    message(FATAL_ERROR "Unknown suite ${SUITE}")
endif()
message(STATUS "ELF CLI ${SUITE}: ${checks} process checks passed")
